import datetime as dt
import time
class library:
    def __init__(self):
        self.name=["story","horror","science","arts"]
    def add_books(self):
        self.add_book=input("Enter the NAME of BOOK :")
        self.name.append(self.add_book)
        print(f"The BOOK{self.add_book}was added successfully on{dt.date.today()}")
    def borrow_book(self):
        your_name=input("Enter the your NAME :")
        self.take_book=input("Enter the Book Name :")
        if self.take_book in self.name:
            self.name.remove(self.take_book)
            print(f"book {self.take_book} borrowed by {your_name}at {dt.date.today}")
        else:
            print("It seems that the Book u entered is not available")
    def availabe_books(self):
        if self.name:
            for i in self.name:
                print(i)
            print("\n")
        else:
            print("There is no BOOKS")
    def return_books(self):
        self.add_=input("Enter the BOOK Name :")
        self.name.append(self.add_)
        print(f"Book {self.add_} is returned successfully")
def main():
    object1=library()
    while True:
        print("Library Management System")
        print("Enter 1 to check AVAILABLE BOOKS")
        print("Enter 2 to BORROW BOOKS")
        print("Enter 3 to RETURN BOOKS")
        print("Enter 4 to ADD NEW BOOKS")
        print("Enter 5 to EXIT")
        print("\n")
        a=int(input("Enter the CHOICE :"))
        if a==1:
            object1.availabe_books()
        elif a==2:
            object1.borrow_book()
        elif a==3:
            object1.return_books()
        elif a==4:
            object1.add_books()
        elif a==5:
            print("Thank YOU...! Visit Again !!!!")
        else:
            print("INVALID ENTRY... TRY AGAIN!")
main()
