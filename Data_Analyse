#Outlier Detection Using IQR

Q1 = sales["sum_total"].quantile(0.25)

Q3 = sales["sum_total"].quantile(0.75)

IQR = Q3 - Q1

lower_bound = Q1 - (1.5 * IQR)

upper_bound = Q3 + (1.5 * IQR)

print("Q1:", Q1)
print("Q3:", Q3)
print("IQR:", IQR)

print("Lower Bound:", lower_bound)
print("Upper Bound:", upper_bound)


outliers = sales[
    (sales["sum_total"] < lower_bound) |
    (sales["sum_total"] > upper_bound)
]

print(
    "Number of Outliers:",
    len(outliers)
)



